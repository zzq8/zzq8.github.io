#!/bin/bash

LOG=/tmp/sleepwatcher.log
PIDFILE=/tmp/sleepwatcher_shutdown.pid

printf "wakeup triggered at %s\n\n" "$(date)" >> "$LOG"

if [ -f "$PIDFILE" ]; then
    pid=$(cat "$PIDFILE" 2>/dev/null)
    if [ -n "$pid" ]; then
        pkill -P "$pid" 2>/dev/null
        kill "$pid" 2>/dev/null
    fi
    rm -f "$PIDFILE"
fi
