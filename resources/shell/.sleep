#!/bin/bash

LOG=/tmp/sleepwatcher.log
WATCHER="$HOME/.sleep-shutdown-watch.sh"

# kill any leftover watcher (exact command-line match, immune to stale PID files)
if /usr/bin/pkill -xf "/bin/bash $WATCHER" 2>/dev/null; then
    echo "killed leftover watcher" >> "$LOG"
fi

echo "sleep triggered at $(/bin/date)" >> "$LOG"

/bin/bash "$WATCHER" >> "$LOG" 2>&1 &
