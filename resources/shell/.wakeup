#!/bin/bash

LOG=/tmp/sleepwatcher.log
WATCHER="$HOME/.sleep-shutdown-watch.sh"

echo "wakeup triggered at $(/bin/date)" >> "$LOG"

# kill the watchdog armed at sleep time (exact command-line match, no PID file)
if /usr/bin/pkill -xf "/bin/bash $WATCHER" 2>/dev/null; then
    echo "watcher killed" >> "$LOG"
fi

echo "" >> "$LOG"
